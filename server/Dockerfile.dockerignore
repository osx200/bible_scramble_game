# Build context for server/Dockerfile is the repo root (BuildKit reads this
# Dockerfile-specific ignore file instead of the root .dockerignore).
# Allow-list: only what the game server image copies.
*
!server/package.json
!server/package-lock.json
!server/*.js
!server/multiplayer
!src/data
!src/utils/wordFilter.js
!src/utils/scramble.js
!src/utils/scoring.js
!src/utils/initials.js
!src/utils/levenshtein.js
